{
    "name": "bijayx/iap-guard-laravel",
    "description": "Server-side verification and ownership protection for Apple App Store and Google Play in-app purchases in Laravel.",
    "keywords": ["laravel", "in-app-purchase", "iap", "app-store", "storekit", "google-play", "play-billing", "subscriptions", "receipt-validation"],
    "homepage": "https://github.com/BijayX/iap-guard-laravel",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Bijay Shrestha",
            "homepage": "https://bijayastha.com.np"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "ext-openssl": "*",
        "illuminate/cache": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/events": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "BijayX\\IapGuard\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BijayX\\IapGuard\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "format": "pint",
        "lint": "pint --test",
        "analyse": "phpstan analyse --memory-limit=1G",
        "ci": [
            "@lint",
            "@analyse",
            "@test"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "BijayX\\IapGuard\\IapGuardServiceProvider"
            ],
            "aliases": {
                "IapGuard": "BijayX\\IapGuard\\Facades\\IapGuard"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
